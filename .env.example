# Server-only. Copy to .env in the project root; never frontend code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Hosted mode requires an exact HTTPS origin, without trailing slash.
APP_ORIGIN=https://YOUR_SERVICE.onrender.com
# Add the corresponding Turnstile secret in Supabase Auth CAPTCHA settings.
TURNSTILE_SITE_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# The worker checks catalog pricing before any model calls.
# Database enforces 3 newly queued jobs per user per rolling 24 hours.
WORKER_POLL_MS=5000
# Optional, a UUID returned by enqueue_research; allows isolated one-job execution.
ONLY_JOB_ID=

# Email: outbox is local testing only; never expose it publicly.
MAIL_DELIVERY_MODE=outbox
# Set mode=resend plus these server-only values for real mail.
RESEND_API_KEY=
MAIL_FROM=
