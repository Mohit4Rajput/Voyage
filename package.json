{
  "name": "voyage-research-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node backend/hosted/start.mjs",
    "dev": "node backend/local/server.mjs",
    "test:local": "node --test backend/tests/local-app.test.mjs",
    "test": "node --test backend/tests/*.test.mjs",
    "worker": "node backend/worker.mjs",
